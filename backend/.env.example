# Copy to backend/.env to change a setting. Everything is optional; these are the defaults.

# The API has no login, so keep it on 127.0.0.1.
HOST=127.0.0.1
PORT=8000
# Address of this backend as seen by your browser; the Google OAuth redirect URI is built from it.
BACKEND_URL=http://127.0.0.1:8000
# Origins allowed to call the API (the web frontend), as a JSON list.
CORS_ORIGINS=["http://localhost:5173"]
# Web setup page that Google OAuth returns to.
WEB_SETUP_URL=http://localhost:5173/setup

# Database and logs go in DATA_DIR (default: data/ at the repo root).
# DATA_DIR=/path/to/data
# DATABASE_PATH=/path/to/job.db
SQL_ECHO=false
# Key that encrypts stored mail credentials. Leave unset to use a generated data/secret.key.
# SECRET_KEY=

# AI is optional and configured in the app (stored encrypted in the database); see docs/setup-ai.md.
