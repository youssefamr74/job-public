# Copy to .env next to docker-compose.yml. Everything is optional; these are the defaults.

# Time zone for daily goals, streaks and "today". Use a name from the tz database, for example America/New_York.
TZ=Europe/Berlin

# Key that encrypts the saved mail credentials. Leave empty to use a key generated in data/secret.key.
SECRET_KEY=

# Address of the backend as your browser sees it. The Google OAuth redirect URI is built from it.
BACKEND_URL=http://localhost:8000

# Web page that Google OAuth returns to after connecting Gmail.
WEB_SETUP_URL=http://localhost:8000/setup
